# Copy to .env. Placeholders only — never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homenursing"
APP_URL="http://localhost:3000"
OTP_SECRET="replace-with-32+-random-chars"
SESSION_TTL_HOURS=168

# Every provider has a dev adapter. Production refuses to boot with any mock/simulated/dev adapter.
ROUTING_PROVIDER="simulated"        # simulated | google  (Routes API, traffic-aware)
GEOCODING_PROVIDER="dev"            # dev | google        (Geocoding API)
GOOGLE_MAPS_API_KEY=""              # server-side only

SMS_PROVIDER="mock"                 # mock | msg91 (DLT-registered templates required)
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""                # DLT template with one variable for general updates
MSG91_OTP_TEMPLATE_ID=""            # DLT OTP template

EMAIL_PROVIDER="mock"               # none | mock | smtp
SMTP_URL=""                         # e.g. smtps://user:pass@email-smtp.ap-south-1.amazonaws.com:465
EMAIL_FROM=""

WHATSAPP_PROVIDER="none"            # none | mock | cloud (Meta WhatsApp Cloud API, approved templates)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

PAYMENT_PROVIDER="mock"             # mock | razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

STORAGE_PROVIDER="mock"             # mock | s3 (any S3-compatible, private bucket)
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""                      # set for R2/MinIO
S3_ACCESS_KEY_ID=""                 # omit to use instance/IRSA credentials
S3_SECRET_ACCESS_KEY=""

ERROR_WEBHOOK_URL=""                # optional: receives redacted error log lines
DEV_EXPOSE_OTP="false"              # "true" shows OTP in the login UI — development only
