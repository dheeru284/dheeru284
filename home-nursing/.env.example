# Copy to .env. Placeholders only — never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homenursing"
APP_URL="http://localhost:3000"
OTP_SECRET="replace-with-32+-random-chars"
SESSION_TTL_HOURS=168
# Development adapters. Production refuses to start with any mock/simulated provider.
SMS_PROVIDER="mock"
ROUTING_PROVIDER="simulated"        # or "google"
GOOGLE_MAPS_API_KEY=""              # server-side only; Routes API enabled
PAYMENT_PROVIDER="mock"             # or "razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STORAGE_PROVIDER="mock"
DEV_EXPOSE_OTP="false"              # "true" shows OTP in the login UI — development only
