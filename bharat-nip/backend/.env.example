# Copy to backend/.env. All variables use the BNIP_ prefix (see ARCHITECTURE.md §8).
BNIP_ENV=development
BNIP_DATABASE_URL=postgresql+psycopg://bnip:bnip@localhost:5432/bnip
BNIP_REDIS_URL=redis://localhost:6379/0
BNIP_CORS_ORIGINS=["http://localhost:3000"]

# AI providers: "ollama" (real, local) or "mock" (scripted, test-only).
BNIP_LLM_PROVIDER=ollama
BNIP_EMBEDDING_PROVIDER=ollama
# Required to use a mock provider in development. Mock is always refused in production.
BNIP_ALLOW_MOCK_PROVIDERS=false
BNIP_OLLAMA_BASE_URL=http://localhost:11434
BNIP_OLLAMA_MODEL=llama3.1:8b
BNIP_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional separate model for the independent critic.
# BNIP_OLLAMA_CRITIC_MODEL=
BNIP_MAX_REVISION_ROUNDS=2

# Search providers: local_corpus (ingested documents), searxng (web), mock (tests/demos).
BNIP_SEARCH_PROVIDERS=["local_corpus"]
# BNIP_SEARXNG_URL=http://localhost:8888
BNIP_FETCH_ALLOW_HTTP=false

# Pipeline runs on Celery workers ("celery") or inside the request ("inline").
BNIP_PIPELINE_EXECUTION=celery
# BNIP_STORAGE_DIR=./storage
# Scripted mock responses for demos (non-production, needs BNIP_ALLOW_MOCK_PROVIDERS=true).
# BNIP_MOCK_FIXTURES_PATH=./fixtures/demo_mock.json

# Required (>=32 chars) when BNIP_ENV=production. Never commit a real value.
# BNIP_JWT_SECRET=

# Used by the test suite.
BNIP_TEST_DATABASE_URL=postgresql+psycopg://bnip:bnip@localhost:5432/bnip_test
