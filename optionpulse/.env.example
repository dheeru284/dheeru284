# Backend (all optional)
OPTIONPULSE_PROVIDER=yahoo         # yahoo: real delayed prices (default) · mock: simulated, works offline
OPTIONPULSE_MOCK_SEED=7            # change to get a different simulated history
OPTIONPULSE_CORS_ORIGINS=http://localhost:3000

# Frontend
OPTIONPULSE_BACKEND_URL=http://127.0.0.1:8000

