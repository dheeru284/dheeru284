# Copy to trader/.env on YOUR server (never commit it, never paste it in chat).

# --- mode -----------------------------------------------------------------
# sim   : no broker, model prices (works anywhere)
# paper : real Angel One quotes, simulated fills, NO orders sent   <- start here
# live  : REAL ORDERS in your Angel One account
MODE=paper
I_UNDERSTAND_LIVE_RISK=no        # must be "yes" for MODE=live

# --- Angel One SmartAPI (smartapi.angelbroking.com → My Apps → Trading API) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=               # your Angel One client ID
ANGEL_PIN=                       # your 4-digit login PIN (MPIN)
ANGEL_TOTP_SECRET=               # the base32 secret shown when enabling TOTP (not the 6-digit code)
ANGEL_PUBLIC_IP=                 # this server's static IP, also registered in the SmartAPI app
ANGEL_LOCAL_IP=127.0.0.1
ANGEL_MAC=00:00:00:00:00:00

# --- risk limits ------------------------------------------------------------
CAPITAL=1500000                  # rupees the sizing assumes
RISK_PCT=2                       # max loss per trade as % of CAPITAL (wing width − credit)
LOTS_MAX=1                       # hard cap on lots per trade
MAX_MONTHLY_LOSS=20000           # pause auto-trading when realised loss this month exceeds this
STOP_MULT=1                      # exit at the close when loss ≥ STOP_MULT × credit (backtested: 1)
HARD_STOP_MULT=1.5               # exit immediately when loss ≥ HARD_STOP_MULT × the stop
# PROFIT_TARGET=0.5              # optional early profit-taking (fraction of credit). Lowered returns in the backtest.

# --- link to the Netlify app (so the Auto-trader tab shows your trades) ----
NETLIFY_SITE_ID=d6cd7c0a-3adc-4ded-a022-362ddee8ff89
NETLIFY_AUTH_TOKEN=              # Netlify → User settings → Applications → Personal access tokens
NTFY_TOPIC=                      # same topic as the app, for trade/exit notifications
POLL_SECONDS=20
