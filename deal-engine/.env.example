# ---- Core ----
DATABASE_URL=postgresql+psycopg2://deals:deals@postgres:5432/deals
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me

# ---- Slack (use ONE of the two) ----
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional per-category channels (bot token only): {"fashion":"C0123","electronics":"C0456"}
SLACK_CHANNEL_MAP=

# ---- Deal rules ----
MIN_RATING=4.0
MIN_REVIEW_COUNT=20
MIN_DISCOUNT_PERCENT=50
MIN_HISTORY_QUALITY=MEDIUM
MIN_OBSERVATIONS=10
MIN_MATCH_CONFIDENCE_FOR_DEALS=80
MAX_PLAUSIBLE_DISCOUNT=92
ALERT_RENOTIFY_AFTER_HOURS=24
ALERT_MATERIAL_CHANGE_PERCENT=5
ALERT_REAPPEAR_DAYS=7

# ---- Scheduling ----
CRAWL_INTERVAL_MINUTES=60            # hot / near-deal products
GENERAL_CRAWL_INTERVAL_MINUTES=360   # everything else
DISCOVERY_INTERVAL_HOURS=24
SCHEDULER_TICK_MINUTES=10

# ---- Politeness ----
USER_AGENT=DealEngineBot/1.0 (+https://your-domain.example/bot; contact@your-domain.example)
PER_DOMAIN_MIN_INTERVAL_SECONDS=3
RESPECT_ROBOTS=true
BROWSER_ENABLED=false

# ---- Retailers ----
ENABLE_AMAZON=true
ENABLE_FLIPKART=true
ENABLE_MYNTRA=true
ENABLE_CROMA=true
ENABLE_RELIANCE_DIGITAL=true
ENABLE_TATA_CLIQ=true
ENABLE_AJIO=true
ENABLE_NYKAA=true
ENABLE_MEESHO=true
ENABLE_VIJAY_SALES=true
ENABLE_PEPPERFRY=true
ENABLE_IKEA=true
ENABLE_FIRSTCRY=true
ENABLE_DECATHLON=true

# ---- Official APIs (Amazon PA-API 5 / Flipkart Affiliate) ----
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# ---- Permitted product feeds (CSV / JSON / JSON-lines; https URL or file path) ----
# FEED_CROMA_URL=https://.../croma-feed.csv
# FEED_MYNTRA_URL=/data/myntra.csv
# FEED_<RETAILER_KEY>_MAP={"price":"sale_price","id":"sku"}

# ---- FX ----
FX_PROVIDER_URL=https://api.frankfurter.app/latest
FX_CACHE_TTL_HOURS=12
# Only used if the provider is down and nothing is cached: {"USD":0} -> leave empty to skip non-INR prices
FX_FALLBACK_RATES=
