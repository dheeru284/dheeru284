# Copy to .env and fill in. Never commit .env. Placeholders only.
DATABASE_URL=postgresql+psycopg://bizdev:CHANGE_ME@db:5432/bizdev
# Generate both with: python -m bizdev.cli gen-keys
SECRET_KEY=CHANGE_ME_min_32_chars
TOKEN_ENCRYPTION_KEY=CHANGE_ME_fernet_key
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# Safety: external sending needs this AND the in-app authorization. Keep false until the launch checklist is done.
ALLOW_LIVE_SEND=false

EMAIL_PROVIDER=mock
CALENDAR_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

APOLLO_API_KEY=
POSTGRES_PASSWORD=CHANGE_ME

# Zoho Mail (EMAIL_PROVIDER=zoho). Use a Zoho APP-SPECIFIC password, never your login password.
ZOHO_SMTP_USER=dheeraj@theepoh.com
ZOHO_APP_PASSWORD=
ZOHO_SMTP_HOST=smtp.zoho.in     # smtp.zoho.com if your account is on zoho.com; smtppro.zoho.* for some org accounts
SENDER_NAME=Dheeraj
